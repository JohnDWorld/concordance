# Base Postgres dédiée (docker-compose.yml)
POSTGRES_PASSWORD=
DB_BIND=127.0.0.1
DB_PORT=5432

# Connexion du pipeline et des migrations
DATABASE_URL=postgresql://postgres:MOT_DE_PASSE@127.0.0.1:5432/concordance

# Ollama (embeddings)
OLLAMA_URL=http://localhost:11434

# Juges (llama.cpp, API compatible OpenAI) : qwen3-30b-a3b et llama3.2
LLM_URL=http://localhost:8012
JUGE2_URL=http://localhost:8013
